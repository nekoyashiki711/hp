---
import BlogListPage from '../../components/BlogListPage.astro';
import { getPosts } from '../../lib/blog';
const posts = await getPosts();
---
<BlogListPage
  title="コラム｜nekoyashiki（宮城の仕事のヒントと、東北の暮らし）"
  description="宮城県仙台市の nekoyashiki のコラム。運送・建築や事務の仕事を軽くするヒントの「しごとの話」と、宮城・東北の山や温泉、食、祭りを紹介する「ていねいな暮らし」をお届けします。"
  heading="コラム"
  eyebrow="COLUMN"
  lead="仕事を軽くするヒントの「しごとの話」と、宮城・東北の楽しみ方を紹介する「ていねいな暮らし」。2つのテーマで書いています。"
  posts={posts}
  series="all"
  usedCategories={posts.map((p) => p.data.category)}
/>

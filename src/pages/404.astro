---
import Base from '../layouts/Base.astro';
---
<Base title="ページが見つかりません｜nekoyashiki" description="お探しのページは見つかりませんでした。" noindex>
  <section class="sub-hero">
    <div class="container">
      <div class="sub-hero__grid sub-hero__text sub-hero__text--narrow">
        <p class="eyebrow" lang="en">404 NOT FOUND</p>
        <h1 class="sub-hero__title sub-hero__title--sm">ページが見つかりません</h1>
        <p class="sub-hero__lead">お探しのページは、移動したか削除された可能性があります。</p>
        <a href="/" class="btn btn--primary btn--lg" style="align-self: flex-start">トップへもどる</a>
      </div>
    </div>
  </section>
</Base>

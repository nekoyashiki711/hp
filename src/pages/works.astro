---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaSection from '../components/CtaSection.astro';
import { LINKS } from '../config/site';
---
<Base
  title="実績｜nekoyashiki"
  description="nekoyashiki のこれまでの歩みと実績。車両広告、地方創生プロジェクトの運営支援、仙台での街フェス開催、防犯タイムスの運営、株式会社 菊田総業の事務効率化・HP制作運営など。"
>
  <section class="sub-hero">
    <div class="container">
      <nav class="crumb" aria-label="パンくずリスト"><a href="/">トップ</a><span aria-hidden="true">/</span><span aria-current="page">実績</span></nav>
      <div class="sub-hero__grid sub-hero__text sub-hero__text--narrow">
        <p class="eyebrow" lang="en">WORKS</p>
        <h1 class="sub-hero__title">実績</h1>
        <p class="sub-hero__lead">これまでの歩みと、お手伝いしてきたことをご紹介します。制作物や改善事例は、準備がととのいしだい掲載していきます。</p>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <SectionHead en="HISTORY" title="これまでの歩み" class="works__head" />
      <div class="works__stats">
        <div class="work-stat">
          <p class="work-stat__num"><span>約</span><b>30</b><span>台</span></p>
          <p class="work-stat__text">運送会社さまの車両に、<br class="pc-only" />広告の掲載が決定</p>
        </div>
        <div class="work-stat">
          <p class="work-stat__num"><b>7</b><span>年</span></p>
          <p class="work-stat__text">全国の地方創生の現場を、<br class="pc-only" />運営から支えてきました</p>
        </div>
        <div class="work-stat">
          <p class="work-stat__num"><b>2015</b></p>
          <p class="work-stat__text">仙台のまちを舞台に、<br class="pc-only" />大型の街フェスを開催</p>
        </div>
        <div class="work-stat">
          <p class="work-stat__media">防犯タイムス</p>
          <p class="work-stat__text">地域の「いま」を届ける<br class="pc-only" />情報メディアを運営</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container g12">
      <div class="span-4"><SectionHead en="CASE" title="お手伝いした事例" class="h2--flush" /></div>
      <dl class="at-6-7 dlist">
        <div><dt>株式会社 菊田総業</dt><dd>事務の効率化・事務代行、HPの制作・運営<br /><a href={LINKS.kikuta} target="_blank" rel="noopener">kikuta.group <span aria-hidden="true">↗</span><span class="visually-hidden">（新しいタブで開きます）</span></a></dd></div>
        <div><dt>防犯タイムス</dt><dd>地域情報メディアの企画・運営<br /><a href={LINKS.bouhan} target="_blank" rel="noopener">bouhan.news <span aria-hidden="true">↗</span><span class="visually-hidden">（新しいタブで開きます）</span></a></dd></div>
      </dl>
    </div>
    <div class="container"><p class="soon">そのほかの実績（地方創生プロジェクトのサイトなど）は、準備ができしだい掲載します。</p></div>
  </section>

  <CtaSection title="まずは、お話から。" lead="ご相談は無料です。ご予算や状況に合わせて、ちょうどいい形をご提案します。" />
</Base>

---
// メインのCTA（LINE）＋サブのCTA（フォーム）。LINE未設定のときは「フォーム」＋「電話」になります。
import Icon from './Icon.astro';
import CtaLine from './CtaLine.astro';
import { hasLine, PATHS, telHref } from '../config/site';
interface Props {
  lineLabel?: string;
  formLabel?: string;
  size?: 'md' | 'lg' | 'xl';
  class?: string;
  fallbackLabel?: string;
}
const { lineLabel = 'LINEで無料相談する', formLabel = 'フォームで問い合わせる', size = 'lg', class: cls, fallbackLabel } = Astro.props;
const primary = `btn btn--primary btn--${size}`;
const secondary = `btn btn--outline btn--${size}-sub`;
---
<div class:list={['cta-pair', cls]}>
  <CtaLine label={lineLabel} fallbackLabel={fallbackLabel} class={primary} iconSize={size === 'xl' ? 26 : 22} />
  {hasLine ? (
    <a href={PATHS.contact} class={secondary}>{formLabel}</a>
  ) : (
    <a href={telHref} class={secondary}><Icon name="phone" size={20} />電話で相談する</a>
  )}
</div>

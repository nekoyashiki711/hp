---
// デザインで使っている線画アイコン（装飾なので読み上げ対象外）
interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: string;
  width?: number;
}
const { name, size = 24, class: cls, stroke = 'currentColor', width = 1.6 } = Astro.props;

const LOGO_BODY =
  'M19.5 19.6Q32 12 44.5 19.6L49.5 15.5L50.2 24.5C52.8 29 54 34.5 54 40.5C54 51 44.5 57.5 32 57.5C19.5 57.5 10 51 10 40.5C10 34.5 11.2 29 13.8 24.5L14.5 15.5Z';

const paths: Record<string, string> = {
  truck:
    '<path d="M2 6.5h12v9.5H2Z"/><path d="M14 9.5h4l3 3.5v3h-7"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/>',
  smartphone: '<rect x="6.5" y="2.5" width="11" height="19" rx="2"/><path d="M10.5 18h3"/>',
  browser:
    '<rect x="2.5" y="4" width="19" height="16" rx="1.5"/><path d="M2.5 9h19"/><path d="M6 6.5h.01"/><path d="M9 6.5h.01"/>',
  pen: '<path d="M4 20l1.2-4.6L16 4.6a2 2 0 0 1 2.8 0l.6.6a2 2 0 0 1 0 2.8L8.6 18.8Z"/><path d="M14 6.6l3.4 3.4"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/>',
  people:
    '<circle cx="8" cy="8" r="3.2"/><circle cx="16.5" cy="9" r="2.6"/><path d="M2.5 20c.4-3.4 2.6-5.5 5.5-5.5s5.1 2.1 5.5 5.5"/><path d="M14 14.8c.8-.4 1.6-.6 2.5-.6 2.5 0 4.3 1.8 4.8 4.8"/>',
  house: '<path d="M3.5 11L12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6l8.5 7 8.5-7"/>',
  phone:
    '<path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6C10.4 20.1 3.9 13.6 3.4 5.2A1.6 1.6 0 0 1 5 3.5Z"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6Z"/><path d="M9 12l2 2 4-4"/>',
  train:
    '<rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 11h16"/><path d="M8 21l1.5-3"/><path d="M16 21l-1.5-3"/><circle cx="8.5" cy="14.5" r="0.6" fill="currentColor"/><circle cx="15.5" cy="14.5" r="0.6" fill="currentColor"/>',
  calendar: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18"/><path d="M8 2v4"/><path d="M16 2v4"/>',
  uniform: '<path d="M8 3h8l1 4H7Z"/><path d="M7 7c-1.5 1-2 2.5-2 4v9h14v-9c0-1.5-.5-3-2-4"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
};

const isLine = name === 'line';
const isLogo = name === 'logo';
---
{isLine ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3.5C6.8 3.5 2.8 6.8 2.8 10.9c0 2.5 1.5 4.7 3.9 6.1L6 20.5l3.9-2.3c.7.1 1.4.2 2.1.2 5.2 0 9.2-3.3 9.2-7.5S17.2 3.5 12 3.5Z" fill="currentColor" />
  </svg>
) : isLogo ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 64 64" fill="none" stroke={stroke} stroke-width={width} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M32 3V15.8" /><path d={LOGO_BODY} /><path d="M23 39h5" /><path d="M36 39h5" /><path d="M51 52.5C56.5 53 59 57 57 61" />
  </svg>
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width={width} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name] ?? ''} />
)}
